{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "database": ["./libs/db/src/index.ts"],
      "database/schemas": ["./libs/db/src/schemas.ts"],
      "database/models": ["./libs/db/src/models.ts"],
      "database/enums": ["./libs/db/src/enums.ts"],
      "auth": ["./libs/auth/src/index.ts"],
      "shared-types": ["./libs/shared-types/src/index.ts"],
      "@/*": ["./*"],
      "utils": ["./libs/utils/src/index.ts"],
      "utils/client": ["./libs/utils/src/index-client.ts"],
      "shared-constants": ["./libs/shared-constants/src/index.ts"],
      "errors": ["./libs/errors/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
