{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "database": ["./libs/db/src/index.ts"],
      "auth": ["./libs/auth/src/index.ts"],
      "shared-types": ["./libs/shared-types/src/index.ts"],
      "validation": ["./libs/validation/src/index.ts"],
      "@/*": ["./*"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
